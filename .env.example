# Optional Docker Compose settings. Keep secrets in Harmonia settings, not this sample.
TZ=America/Chicago
HARMONIA_PORT=8173
# Environment variables use the Harmonia name; no legacy aliases.
HARMONIA_UPDATE_CHANNEL=beta

# Default host port is private to this machine. For a Docker-network proxy,
# configure a reachable bind address and restrict ingress to that proxy.
HARMONIA_BIND_ADDRESS=127.0.0.1
# Set true for public HTTPS deployments; requests seen as HTTP are rejected.
HARMONIA_HTTPS_ONLY=false
# Exact source IPs/CIDRs of trusted proxies, never * or an unrestricted network.
HARMONIA_TRUSTED_PROXIES=127.0.0.1,::1
